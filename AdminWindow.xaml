<Window x:Class="ShkafMFSB.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шкаф МФСБ — Администрирование" Width="1280" Height="820" WindowStartupLocation="CenterOwner" Background="#0F172A">
    <Grid>
        <!-- Экран ввода PIN -->
        <Grid x:Name="PinPanel" Background="#0F172A">
            <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Введите PIN" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <PasswordBox x:Name="PinBox" Padding="10" FontSize="18" PasswordChar="●"/>
                <Button Content="Войти" Margin="0,10,0,0" Padding="10" Background="#1E40AF" Foreground="White" Click="Login_Click"/>
            </StackPanel>
        </Grid>

        <!-- Основная панель -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <TabControl Margin="10" Background="Transparent" BorderThickness="0">
                <!-- Вкладка Сотрудники -->
                <TabItem Header="Сотрудники">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Margin="0,0,0,10" Padding="5" Background="#1F2937" Foreground="White"/>
                            <DataGrid x:Name="EmpGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="EmpGrid_SelectionChanged" Background="#1F2937" Foreground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Ячейка" Binding="{Binding LockerDisplay}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1F2937" Margin="10,0,0,0" Padding="20">
                            <StackPanel x:Name="EmpDetailsPanel">
                                <TextBlock Text="Выберите сотрудника" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,50,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Вкладка Ячейки -->
                <TabItem Header="Ячейки">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                        <Grid x:Name="LockerMatrix" Grid.Column="0" Margin="0,0,10,0" MaxWidth="560" HorizontalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#1F2937" Padding="20">
                            <StackPanel x:Name="LockerDetailsPanel">
                                <TextBlock Text="Выберите ячейку" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,50,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Вкладка Настройки -->
                <TabItem Header="Настройки">
                    <StackPanel Margin="20">
                        <TextBlock Text="Привязка оборудования (Модуль / Канал)" FontSize="18" Foreground="White" Margin="0,0,0,10"/>
                        <DataGrid x:Name="HardwareGrid" AutoGenerateColumns="False" Background="#1F2937" Foreground="White" Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ячейка" Binding="{Binding Id}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Модуль" Binding="{Binding ModuleId}"/>
                                <DataGridTextColumn Header="Канал" Binding="{Binding ChannelId}"/>
                                <DataGridTemplateColumn Header="Тест">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Открыть" Click="TestRelay_Click" Tag="{Binding}" Background="#1E40AF" Foreground="White" Padding="5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Сохранить привязку" Click="SaveHardware_Click" Background="#1B7A3D" Foreground="White" Padding="10" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
