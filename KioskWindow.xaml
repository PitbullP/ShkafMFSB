<Window x:Class="ShkafMFSB.KioskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" Topmost="True" Cursor="None" Background="#0B2A4A">
    <Grid x:Name="RootGrid">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="300" Height="300" Fill="#22FFFFFF"/>
            <Path x:Name="IconPath" Data="{StaticResource Icon.Idle}" Fill="White" Width="160" Height="160" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,-230,0,0"/>
            <TextBlock x:Name="TxtMain" Text="Приложите карту к считывателю" FontSize="72" FontWeight="Bold" Foreground="White" TextAlignment="Center" Margin="0,40,0,0"/>
            <TextBlock x:Name="TxtSub" FontSize="40" Foreground="#DDDDDD" TextAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Border x:Name="DemoBanner" Background="#B45309" Padding="20,10" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock Text="⚠️ ДЕМО-РЕЖИМ: оборудование эмулируется"
                       Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
        <Rectangle Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="Transparent" MouseDown="AdminZone_MouseDown"/>
    </Grid>
</Window>
