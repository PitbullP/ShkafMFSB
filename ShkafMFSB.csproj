<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShkafMFSB</AssemblyName>
    <RootNamespace>ShkafMFSB</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Исключаем папку Core из компиляции WPF-проекта (она собирается отдельным проектом) -->
    <Compile Remove="ShkafMFSB.Core\**\*.cs" />
    <None Remove="ShkafMFSB.Core\**\*" />
    <EmbeddedResource Remove="ShkafMFSB.Core\**\*" />
    <Page Remove="ShkafMFSB.Core\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Копируем конфиг -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    
    <!-- Ссылка на Core (Database, Hardware, Logger, Models) -->
    <ProjectReference Include="ShkafMFSB.Core\ShkafMFSB.Core.csproj" />

    <!-- Встраиваем HTML в EXE (на всякий случай) -->
    <EmbeddedResource Include="web\index.html" />
    
    <!-- Копируем папку web рядом с EXE -->
    <None Update="web\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
